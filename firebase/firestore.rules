rules_version = '2';

// RESTAURANT OS - Firestore Security Rules
// Default is DENY: any path not matched below is inaccessible.
// Privileged writes (tenant creation, memberships, orders, financial records,
// audit logs) are performed ONLY by trusted server code via the Admin SDK,
// which bypasses these rules and therefore must verify access itself.
// STATUS: written, not yet executed against the emulator (see docs/TENANT_ISOLATION.md).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers
    function signedIn() {
      return request.auth != null;
    }

    function platformUserPath() {
      return /databases/$(database)/documents/platformUsers/$(request.auth.uid);
    }

    function isPlatformAdmin() {
      return signedIn()
        && exists(platformUserPath())
        && get(platformUserPath()).data.status == 'ACTIVE'
        && get(platformUserPath()).data.role in ['SUPER_ADMIN', 'PLATFORM_SUPPORT'];
    }

    function tenantPath(t) {
      return /databases/$(database)/documents/tenants/$(t);
    }

    function memberPath(t) {
      return /databases/$(database)/documents/tenants/$(t)/members/$(request.auth.uid);
    }

    function tenantIsActive(t) {
      return exists(tenantPath(t)) && get(tenantPath(t)).data.status == 'ACTIVE';
    }

    // Active membership, regardless of tenant status (lets a suspended tenant's staff see why).
    function hasActiveMembership(t) {
      return signedIn()
        && exists(memberPath(t))
        && get(memberPath(t)).data.status == 'ACTIVE';
    }

    // Active membership in an ACTIVE tenant. Suspension revokes access to all tenant data.
    function isActiveMember(t) {
      return hasActiveMembership(t) && tenantIsActive(t);
    }

    function can(t, perm) {
      return isActiveMember(t) && perm in get(memberPath(t)).data.permissions;
    }

    // Every tenant-owned document carries its tenantId; it must match the path and never change.
    function createsWithTenantId(t) {
      return request.resource.data.tenantId == t;
    }

    function updatesKeepingTenantId(t) {
      return request.resource.data.tenantId == t && resource.data.tenantId == t;
    }

    function canCreate(t, perm) {
      return can(t, perm) && createsWithTenantId(t);
    }

    function canUpdate(t, perm) {
      return can(t, perm) && updatesKeepingTenantId(t);
    }

    // --------------------------------------------------------------- platform
    match /platformUsers/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isPlatformAdmin());
      allow list: if isPlatformAdmin();
      allow write: if false; // bootstrap and changes: trusted server only
    }

    match /platformSettings/{settingId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /platformAuditLogs/{logId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    // Public website data, written by the server for ACTIVE tenants only.
    match /publicProfiles/{tenantId} {
      allow read: if resource.data.status == 'ACTIVE';
      allow write: if false;
    }

    // ------------------------------------------------------------ onboarding
    match /tenantApplications/{applicationId} {
      allow get, list: if signedIn()
        && (resource.data.ownerUid == request.auth.uid || isPlatformAdmin());

      // Owners may only submit a PENDING application for themselves.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['ownerUid', 'restaurantName', 'businessType', 'city', 'country', 'phone', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(
             ['ownerUid', 'restaurantName', 'businessType', 'city', 'country', 'phone', 'status', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.restaurantName is string
        && request.resource.data.restaurantName.size() >= 2
        && request.resource.data.restaurantName.size() <= 80
        && request.resource.data.createdAt == request.time;

      // Approval and rejection are server-only.
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------- tenants
    match /tenants/{tenantId} {
      allow get: if hasActiveMembership(tenantId) || isPlatformAdmin();
      allow list: if isPlatformAdmin();
      allow create, delete: if false; // tenant creation: server only, after approval

      // Settings managers may edit presentation fields only. status, subscription,
      // ownerUid and createdAt cannot be changed from the client.
      allow update: if can(tenantId, 'SETTINGS_MANAGE')
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['profile', 'branding', 'website', 'settings', 'updatedAt']);

      // Memberships and roles are server-controlled: nobody can grant themselves a role.
      match /members/{memberUid} {
        allow get: if signedIn()
          && (request.auth.uid == memberUid || can(tenantId, 'STAFF_MANAGE') || isPlatformAdmin());
        allow list: if can(tenantId, 'STAFF_MANAGE') || isPlatformAdmin();
        allow write: if false;
      }

      match /branches/{id} {
        allow read: if isActiveMember(tenantId);
        allow create: if canCreate(tenantId, 'SETTINGS_MANAGE');
        allow update: if canUpdate(tenantId, 'SETTINGS_MANAGE');
        allow delete: if can(tenantId, 'SETTINGS_MANAGE');
      }

      // Menu data. Documents with visibility == 'PUBLIC' also feed the public website.
      match /categories/{id} {
        allow read: if isActiveMember(tenantId)
          || (tenantIsActive(tenantId) && resource.data.visibility == 'PUBLIC');
        allow create: if canCreate(tenantId, 'MENU_MANAGE');
        allow update: if canUpdate(tenantId, 'MENU_MANAGE');
        allow delete: if can(tenantId, 'MENU_MANAGE');
      }

      match /products/{id} {
        allow read: if isActiveMember(tenantId)
          || (tenantIsActive(tenantId) && resource.data.visibility == 'PUBLIC');
        allow create: if canCreate(tenantId, 'MENU_MANAGE');
        allow update: if canUpdate(tenantId, 'MENU_MANAGE');
        allow delete: if can(tenantId, 'MENU_MANAGE');
      }

      match /menus/{id} {
        allow read: if isActiveMember(tenantId)
          || (tenantIsActive(tenantId) && resource.data.visibility == 'PUBLIC');
        allow create: if canCreate(tenantId, 'MENU_MANAGE');
        allow update: if canUpdate(tenantId, 'MENU_MANAGE');
        allow delete: if can(tenantId, 'MENU_MANAGE');
      }

      match /coupons/{id} {
        allow read: if isActiveMember(tenantId);
        allow create: if canCreate(tenantId, 'MENU_MANAGE');
        allow update: if canUpdate(tenantId, 'MENU_MANAGE');
        allow delete: if can(tenantId, 'MENU_MANAGE');
      }

      // Orders are priced and written by the server only (never trust client totals).
      match /orders/{id} {
        allow read: if can(tenantId, 'ORDERS_READ') || can(tenantId, 'KITCHEN_READ');
        allow write: if false;
      }

      match /customers/{id} {
        allow read: if can(tenantId, 'CUSTOMERS_READ') || can(tenantId, 'CUSTOMERS_MANAGE');
        allow create: if canCreate(tenantId, 'CUSTOMERS_MANAGE');
        allow update: if canUpdate(tenantId, 'CUSTOMERS_MANAGE');
        allow delete: if false;
      }

      match /tables/{id} {
        allow read: if isActiveMember(tenantId);
        allow create: if canCreate(tenantId, 'TABLES_MANAGE');
        allow update: if canUpdate(tenantId, 'TABLES_MANAGE');
        allow delete: if can(tenantId, 'TABLES_MANAGE');
      }

      match /reservations/{id} {
        allow read: if can(tenantId, 'RESERVATIONS_MANAGE') || can(tenantId, 'TABLES_MANAGE');
        allow create: if canCreate(tenantId, 'RESERVATIONS_MANAGE');
        allow update: if canUpdate(tenantId, 'RESERVATIONS_MANAGE');
        allow delete: if false;
      }

      match /employees/{id} {
        allow read: if can(tenantId, 'STAFF_MANAGE');
        allow create: if canCreate(tenantId, 'STAFF_MANAGE');
        allow update: if canUpdate(tenantId, 'STAFF_MANAGE');
        allow delete: if false;
      }

      // Inventory: records are archived, not deleted, to keep history.
      match /inventory/{id} {
        allow read: if can(tenantId, 'INVENTORY_READ') || can(tenantId, 'INVENTORY_MANAGE');
        allow create: if canCreate(tenantId, 'INVENTORY_MANAGE');
        allow update: if canUpdate(tenantId, 'INVENTORY_MANAGE');
        allow delete: if false;
      }

      match /suppliers/{id} {
        allow read: if can(tenantId, 'INVENTORY_READ') || can(tenantId, 'INVENTORY_MANAGE');
        allow create: if canCreate(tenantId, 'INVENTORY_MANAGE');
        allow update: if canUpdate(tenantId, 'INVENTORY_MANAGE');
        allow delete: if false;
      }

      match /recipes/{id} {
        allow read: if can(tenantId, 'INVENTORY_READ') || can(tenantId, 'INVENTORY_MANAGE');
        allow create: if canCreate(tenantId, 'INVENTORY_MANAGE');
        allow update: if canUpdate(tenantId, 'INVENTORY_MANAGE');
        allow delete: if false;
      }

      // Immutable ledger: clients can read but never write. Corrections are new server-written entries.
      match /transactions/{id} {
        allow read: if can(tenantId, 'FINANCIAL_READ');
        allow write: if false;
      }

      // Expenses are append-only; fix mistakes with a correcting entry.
      match /expenses/{id} {
        allow read: if can(tenantId, 'FINANCIAL_READ');
        allow create: if canCreate(tenantId, 'FINANCIAL_MANAGE');
        allow update, delete: if false;
      }

      match /reviews/{id} {
        allow read: if isActiveMember(tenantId);
        allow write: if false;
      }

      match /notifications/{id} {
        allow read: if isActiveMember(tenantId);
        allow write: if false;
      }

      match /auditLogs/{id} {
        allow read: if can(tenantId, 'AUDIT_READ');
        allow write: if false;
      }
    }
  }
}
